# ==========================================
# MongoDB Connection Configuration
# ==========================================
# Local Development URI:
MONGODB_URI=mongodb://localhost:27017
# Docker Compose URI:
# MONGODB_URI=mongodb://mongodb:27017

MONGODB_DATABASE=chest_xray_ai
MONGODB_COLLECTION=predictions
MONGODB_USERS_COLLECTION=users

# ==========================================
# JWT Authentication Configuration
# ==========================================
JWT_SECRET_KEY=your-secure-random-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Automatic File Cleanup Configuration (Step 9)
# ==========================================
CLEANUP_ORPHAN_RETENTION_HOURS=24
CLEANUP_TEMP_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
CLEANUP_ENABLED=true

# ==========================================
# AI Health Assistant Chatbot Configuration
# ==========================================
# 1. Groq (Fastest free tier for Alibaba Qwen): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 2. Google Gemini 1.5 Flash (Free tier): https://aistudio.google.com/
GEMINI_API_KEY=

# 3. OpenRouter (Free tier): https://openrouter.ai/keys
OPENROUTER_API_KEY=
